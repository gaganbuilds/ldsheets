rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || 
                  (resource == null || resource.data.isPublicProfile == true);
                  
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == 'student'
                    && request.resource.data.get('isAdmin', false) == false;
                    
      allow update: if request.auth != null && request.auth.uid == userId 
        // Cannot change role or admin status
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']))
        && (
          // If totalXP changes, must be valid amount
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalXP'])) ||
          (
            request.resource.data.totalXP >= resource.data.totalXP &&
            (request.resource.data.totalXP - resource.data.totalXP) <= 1000
          )
        )
        && (
          // If completedProblems changes, must only increment/decrement by 1
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedProblems'])) ||
          (
            request.resource.data.completedProblems == resource.data.completedProblems + 1 ||
            request.resource.data.completedProblems == resource.data.completedProblems - 1
          )
        );
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    
    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /roadmaps/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /topics/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /problems/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /user_progress/{document} {
      allow get: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /user_notes/{document} {
      allow get: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /xp_history/{document} {
      allow get: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /badges/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /user_badges/{document} {
      allow get: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /user_activity/{document} {
      allow get: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
