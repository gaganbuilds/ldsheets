rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
                  
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == 'student'
                    && request.resource.data.get('isAdmin', false) == false;
                    
      allow update: if request.auth != null && request.auth.uid == userId 
        // Cannot change role or admin status
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']))
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalXP'])) ||
          (request.resource.data.totalXP >= resource.data.totalXP && (request.resource.data.totalXP - resource.data.totalXP) <= 1000)
        )
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['level'])) ||
          (request.resource.data.level == resource.data.level + 1 || request.resource.data.level == resource.data.level)
        )
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedProblems'])) ||
          (request.resource.data.completedProblems == resource.data.completedProblems + 1 || request.resource.data.completedProblems == resource.data.completedProblems - 1)
        )
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentStreak'])) ||
          (request.resource.data.currentStreak == resource.data.currentStreak + 1 || request.resource.data.currentStreak <= 1)
        )
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['longestStreak'])) ||
          (request.resource.data.longestStreak == resource.data.longestStreak + 1 || request.resource.data.longestStreak == resource.data.longestStreak)
        );
    }
    
    match /public_profiles/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId 
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalXP'])) ||
          (request.resource.data.totalXP >= resource.data.totalXP && (request.resource.data.totalXP - resource.data.totalXP) <= 1000)
        )
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['level'])) ||
          (request.resource.data.level == resource.data.level + 1 || request.resource.data.level == resource.data.level)
        )
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedProblems'])) ||
          (request.resource.data.completedProblems == resource.data.completedProblems + 1 || request.resource.data.completedProblems == resource.data.completedProblems - 1)
        )
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentStreak'])) ||
          (request.resource.data.currentStreak == resource.data.currentStreak + 1 || request.resource.data.currentStreak <= 1)
        )
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['longestStreak'])) ||
          (request.resource.data.longestStreak == resource.data.longestStreak + 1 || request.resource.data.longestStreak == resource.data.longestStreak)
        );
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /roadmaps/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /topics/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /problems/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /user_progress/{document} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId
                    && document == request.auth.uid + "_" + request.resource.data.problemId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId 
                    && request.resource.data.userId == request.auth.uid;
    }
    
    match /user_notes/{document} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId 
                    && request.resource.data.userId == request.auth.uid;
    }
    
    match /xp_history/{document} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.userId 
        && document == request.auth.uid + "_" + request.resource.data.problemId
        && request.resource.data.xp in [10, 25, 50, 100];
    }
    
    match /badges/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /user_badges/{document} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.userId
        && document == request.auth.uid + "_" + request.resource.data.badgeId
        && request.resource.data.xpReward <= 1000;
      allow update: if false; // Badges never update XP after creation
    }
    
    match /user_activity/{document} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId 
                    && request.resource.data.userId == request.auth.uid;
    }
  }
}
