rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Function to ensure the file is an image and under 2MB
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') 
          && request.resource.size < 2 * 1024 * 1024;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Profile Images
    // Example path: profile-images/{userId}/avatar.png
    match /profile-images/{userId}/{fileName} {
      // Anyone can read public profile images
      allow read: if true;
      
      // Only the user themselves can upload/update/delete their own image
      // Must be a valid image under 2MB
      allow write: if request.auth != null 
                   && request.auth.uid == userId 
                   && (request.resource == null || isValidImage());
    }
  }
}
